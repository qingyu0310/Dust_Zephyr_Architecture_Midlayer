# midlayer/zephyr/Kconfig - user_midlayer 模块 Kconfig
# 由 Zephyr 模块机制自动加载（module.yml kconfig: zephyr/Kconfig），业务项目无需手动 rsource。
# rsource 相对本文件目录（midlayer/zephyr/），故加 ../ 回到模块根。
#
# 中间层只放协议栈：usb/（USB 枚举 + CDC）与 ethercat/（AL 状态机 + 邮箱 + SDO + PDO）。
# 驱动（Pwm / Output / Input / Can / Spi / UartDma / Rs485）在 framework/drivers/，不在这里。

config DUST_COM_ETHERCAT
    default n
    bool "EtherCAT slave"
    help
        Enable the EtherCAT slave protocol stack in midlayer/ethercat.
        C++ 实现，行为派生自倍福 SSC 5.13；派生范围与来源见
        midlayer/ethercat/core/LICENSE-BECKHOFF.md，
        该部分不受本项目 Apache-2.0 覆盖。
        硬件实现（ESC 寄存器、IRQ、PHY、SII）由底层 zephyr/drivers/ 提供，本层不含任何厂商代码。

config DUST_COM_USB
    default n
    bool "USB CDC ACM driver"
    select DUST_BUF_BIPBUF
    select DUST_USB_DEVICE_STACK
    select DYNAMIC_INTERRUPTS
    help
        Enable the C++ USB device CDC ACM stream in midlayer/usb.
        硬件实现（EHCI / OTG FS 寄存器、端点、PHY）由底层 zephyr/drivers/ 提供。

rsource "../usb/Kconfig"
