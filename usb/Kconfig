# USB 协议栈内核（枚举 / CDC / 描述符 / 端点）
# 各芯片 HAL 定义在 zephyr/drivers/Kconfig（底层，与芯片耦合）
config DUST_USB_DEVICE_STACK
    bool
    select DUST_USB_DEVICE_CDC_ACM
    # 各芯片 HAL 用 DTS 条件 select（HAL 定义在 zephyr/drivers/Kconfig）
    select DUST_USB_DEVICE_HAL_HPM if DT_HAS_HPMICRO_HPM_DUSTUSB_ENABLED
    select DUST_USB_DEVICE_HAL_STM32 if DT_HAS_ST_ST_DUSTUSB_ENABLED

config DUST_USB_DEVICE_CDC_ACM
    bool
    default n
